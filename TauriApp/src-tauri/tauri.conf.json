{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "../../PythonInterface/dist/even_photos_resolve"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Conform Sidekick",
  "mainBinaryName": "Conform Sidekick",
  "version": "1.1.1",
  "identifier": "com.conformsidekick",
  "plugins": {},
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Conform Sidekick",
        "hiddenTitle": true,
        "width": 800,
        "height": 600,
        "minWidth": 700,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "useHttpsScheme": true
      }
    ]
  }
}